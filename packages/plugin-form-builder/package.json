{
  "name": "@inflowenger/plugin-form-builder",
  "version": "0.1.8",
  "description": "Vue 3 + JSON Forms renderer for Inflow's x-inflow-ui schema extension — schema-driven forms with actions and buttons",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./vanilla-fixes.css": "./dist/vanilla-fixes.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@jsonforms/core": "^3.0.0",
    "@jsonforms/vue": "^3.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/vue": "^3.8.0",
    "@jsonforms/vue-vanilla": "^3.8.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "jsonforms",
    "vue3",
    "typescript",
    "form",
    "form-builder",
    "ui-schema",
    "inflow"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inflowenger/inflow-js.git",
    "directory": "packages/plugin-form-builder"
  },
  "homepage": "https://github.com/Inflowenger/inflow-js/tree/master/packages/plugin-form-builder",
  "bugs": {
    "url": "https://github.com/Inflowenger/inflow-js/issues"
  }
}
